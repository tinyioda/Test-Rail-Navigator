@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-6 col-lg-4">
        <div class="card">
            <div class="card-header">
                <h1 class="mb-0">Sign in to TestRail Navigator</h1>
            </div>
            <div class="card-body">
                @if (!Model.IsConfigured)
                {
                    <div class="alert alert-warning mb-0" role="alert">
                        <p class="fw-semibold">Administrator credentials are not configured.</p>
                        <p>Access is disabled until an administrator provisions
                            <code>TestRail:SetupUsername</code> and <code>TestRail:SetupPassword</code>
                            through server configuration or user secrets, or sets
                            <code>SetupUsername</code> and <code>SetupPassword</code> in the existing settings file.</p>
                        <p class="mb-0">Restart the app after changing the settings file. There is no public account-registration flow.</p>
                    </div>
                }
                else
                {
                    <p id="login-help" class="text-muted">Use the administrator credentials previously used for Setup.</p>
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
                    }
                    <form method="post">
                        <input asp-for="ReturnUrl" type="hidden" />
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label"></label>
                            <input asp-for="Username" class="form-control" autocomplete="username"
                                   maxlength="128" aria-describedby="login-help" required autofocus />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" autocomplete="current-password"
                                   maxlength="1024" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Sign in</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
