@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-6 col-lg-4">
        <div class="card">
            <div class="card-header">
                <h1 class="mb-0">Sign in to TestRail Navigator</h1>
            </div>
            <div class="card-body">
                @if (!Model.IsConfigured)
                {
                    <div class="alert alert-warning mb-0" role="alert">
                        <p class="fw-semibold">TestRail connection is not configured.</p>
                        <p>Sign-in is disabled until an administrator configures the TestRail URL and API
                            key on the <a asp-page="/Setup">Setup</a> page.</p>
                    </div>
                }
                else
                {
                    <p id="login-help" class="text-muted">Sign in with your own TestRail username and password.</p>
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
                    }
                    <form method="post">
                        <input asp-for="ReturnUrl" type="hidden" />
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label"></label>
                            <input asp-for="Username" class="form-control" autocomplete="username"
                                   maxlength="128" aria-describedby="login-help" required autofocus />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" autocomplete="current-password"
                                   maxlength="1024" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Sign in</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
